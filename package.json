{
  "name": "proxispeak",
  "version": "1.0.0",
  "private": true,
  "description": "ProxiSpeak — Real-Time Geospatial Proximity Audio Platform",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node server/src/index.js",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:client",
    "seed": "node server/src/seed/seedData.js"
  }
}
