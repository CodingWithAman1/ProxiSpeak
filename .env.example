# ---------------------------------------------------------------------------
# ProxiSpeak Configuration Environment Template
# Copy this file to `.env` in the repository root.
# ---------------------------------------------------------------------------

# Port the Express server listens on
PORT=4000

# Node Environment: development | production
NODE_ENV=development

# MongoDB connection string
# Local: mongodb://127.0.0.1:27017/proxispeak
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/proxispeak
MONGO_URI=mongodb://127.0.0.1:27017/proxispeak

# Redis connection string (optional - falls back to high-performance in-memory adapter)
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=false

# Allowed browser origins for CORS (comma separated)
CLIENT_URL=http://localhost:5173,http://localhost:4000

# Spatial Engine Acoustics & Proximity Tuning
DEFAULT_EARSHOT_RADIUS=20
MIN_HEARING_DISTANCE=2
WALL_ATTENUATION_DB=18
WALL_CUTOFF_FREQ=480
TICK_RATE_MS=50
